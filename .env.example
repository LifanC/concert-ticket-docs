# 共用環境變數範本（Docker / Java / Python / Vue）
# 在專案根目錄執行，依需要複製；已有 .env 時請合併設定，避免覆蓋密碼：
# Docker 或從根目錄啟動 Java：Copy-Item .env.example .env
# 從後端目錄啟動 Java：Copy-Item .env.example concert-ticket-backend/.env
# 手動執行 Python：Copy-Item .env.example concert-ticket-analytics/.env
# Vue 本機開發：只將下方 VITE_* 區塊放入 concert-ticket-frontend/.env
# Java 從根目錄或後端目錄啟動皆可讀取兩處 .env；同名參數以後端 .env 優先。
# Docker 使用根目錄 .env；Python 與 Vue 仍讀取各自目錄的 .env。

# Java / Docker 資料庫密碼；Python 手動執行也使用 POSTGRES_PASSWORD
# DB_URL=jdbc:postgresql://你的Render資料庫Host:5432/資料庫名稱?currentSchema=interviewworks_ticket
# DB_URL=jdbc:postgresql://dpg-db69djss728c73flkmug-a:5432/interviewworks_ticket_xdef?currentSchema=interviewworks_ticket
# DB_USERNAME=Render 資料庫使用者名稱
# DB_PASSWORD=Render 資料庫密碼
POSTGRES_PASSWORD=1234
# REDIS_HOST=redis://red-db69hhijnfac73cul640:6379
REDIS_PASSWORD=1234
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax

# HTTPS 正式環境必須設定 REFRESH_COOKIE_SECURE=true。
# 模擬付款預設關閉；僅供本機示範，正式售票須整合金流驗證。
PAYMENT_SIMULATION_ENABLED=false
ALLOWED_ORIGINS=http://localhost:5173,https://concert-ticket-frontend.onrender.com

# Java 自動執行 Python 銷售分析：每次完成後等待 30 分鐘
ANALYTICS_ENABLED=true
ANALYTICS_DELAY_MS=1800000
ANALYTICS_TIMEOUT_SECONDS=120

# 本機路徑：留空時自動尋找專案內的分析資料夾與 .venv
# Docker Compose 會另外提供容器內的路徑
ANALYTICS_DIRECTORY=
ANALYTICS_PYTHON=
# 自訂 Windows 路徑時使用正斜線，例如：
# ANALYTICS_DIRECTORY=C:/A_TestSpring/concert-ticket-docs/concert-ticket-analytics
# ANALYTICS_PYTHON=C:/A_TestSpring/concert-ticket-docs/concert-ticket-analytics/.venv/Scripts/python.exe
# ANALYTICS_DIRECTORY=/app/concert-ticket-analytics
# ANALYTICS_PYTHON=/opt/analytics-venv/bin/python

# Vue 開發伺服器使用；放入 concert-ticket-frontend/.env
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_URL=http://localhost:8080/api/ws

